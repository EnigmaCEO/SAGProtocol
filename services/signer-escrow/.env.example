# Escrow authority signing key.
# This service signs ONLY for the Escrow role (roleId=1).
# Never share this key with the treasury signer or any other service.
# This key also pays gas for anchor transactions — keep it funded.
ESCROW_SIGNER_PRIVATE_KEY=0x...

# RPC endpoint for the target chain. This service reads from chain directly.
RPC_URL=http://localhost:8545

# Chain ID (numeric, e.g. 31337 for localhost Hardhat).
CHAIN_ID=31337

# Deployed contract addresses on the target chain.
TREASURY_CONTRACT_ADDRESS=0x...
INVESTMENT_ESCROW_ADDRESS=0x...
VAULT_CONTRACT_ADDRESS=0x...

# DAO system registry version string — must match the value used in the frontend.
DAO_SYSTEM_REGISTRY_VERSION=v1.0.0-arc-testnet

# Port this service listens on (default: 4002).
PORT=4002

# Allowed CORS origin for the frontend (default: http://localhost:3000).
CORS_ORIGIN=http://localhost:3000

# Optional: URL of the wallet-factory service. When set and the anchor request
# specifies custodyMode=batch_wallet_custody, the escrow signer immediately calls
# the wallet-factory after a successful anchor so wallet creation is part of the
# same autonomous pipeline step with no frontend involvement.
WALLET_FACTORY_URL=http://localhost:4003
