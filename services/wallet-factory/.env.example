# Private key for the wallet-factory keeper. This account pays gas for multisig
# deployment and bindBatchWallet() transactions. It does NOT need to be a role
# authority signer — any funded account works.
WALLET_FACTORY_PRIVATE_KEY=0x...

# RPC endpoint for the target chain.
RPC_URL=http://localhost:8545

# Chain ID (numeric, e.g. 31337 for localhost Hardhat).
CHAIN_ID=31337

# Deployed contract addresses on the target chain.
INVESTMENT_ESCROW_ADDRESS=0x...

# Port this service listens on (default: 4003).
PORT=4003

# Allowed CORS origin for the frontend (default: http://localhost:3000).
CORS_ORIGIN=http://localhost:3000
