NEXT_PUBLIC_NETWORK=local
NEXT_PUBLIC_RPC_URL=http://127.0.0.1:8545
NEXT_PUBLIC_CHAIN_ID=1337

# URL of the banking backend server
# BANKING_API_URL is server-only (used by Next.js API proxy routes, never sent to browser)
BANKING_API_URL=http://localhost:4000
NEXT_PUBLIC_BANKING_API_URL=http://localhost:4000

# Autonomous signer service URLs.
# When set, the Escrow UI requests signatures from these services instead of using
# a browser wallet. Each service independently reconstructs the EIP-712 payload
# from chain state and signs — the frontend never supplies the signing payload.
# Leave unset to fall back to browser wallet signing (development convenience).
NEXT_PUBLIC_TREASURY_SIGNER_URL=http://localhost:4001
NEXT_PUBLIC_ESCROW_SIGNER_URL=http://localhost:4002
NEXT_PUBLIC_WALLET_FACTORY_URL=http://localhost:4003

# Set to "true" to show manual signing buttons in the Authority Binding panel.
# These are dev-only tools; they must never be visible in operator/production builds.
NEXT_PUBLIC_DEV_SIGNING_TOOLS=

NEXT_PUBLIC_TREASURY_SIGNER_ADDRESS=0x70997970C51812dc3A010C7d01b50e0d17dc79C8
NEXT_PUBLIC_ESCROW_SIGNER_ADDRESS=0x3C44CdDdB6a900fa2b585dd299e03d12FA4293BC
NEXT_PUBLIC_CONTINUITY_SIGNER_ADDRESS=0x90F79bf6EB2c4f870365E785982E1f101E93b906