# ── On-chain reserve gate ──────────────────────────────────────────────────
# RESERVE_GATE_SOURCE controls where navReserveUsd is read from.
#   env     — use SAGITTA_TEST_RESERVE_AMOUNT (demo-only default)
#   onchain — call navReserveUsd() on the deployed ReserveController (production)
#
# When RESERVE_GATE_SOURCE=onchain:
#   - ARC_RPC_URL must be set.
#   - If the RPC call fails the FD approval is blocked (fail closed; no silent fallback).
RESERVE_GATE_SOURCE=env

# Arc JSON-RPC endpoint. Required when RESERVE_GATE_SOURCE=onchain.
ARC_RPC_URL=https://rpc.testnet.arc.network

# ReserveController contract address on Arc. Defaults to the Arc deployment if unset.
RESERVE_CONTROLLER_ADDRESS=0x23856AAcc3BCC07D25FDbc4D0aa54f6F6C5f78cd

# ── Committed reserve registry ─────────────────────────────────────────────
# Path to the JSON registry of active Sagitta-backed fixed deposits.
# Used by demo:reserve-available to compute committedReserveUsd before the gate.
# Defaults to out/sagitta-active-deposits-registry.json when unset.
# Fail-closed: if the file exists but cannot be read/parsed, the gate rejects.
COMMITTED_RESERVE_REGISTRY=

# ── Fineract connection ────────────────────────────────────────────────────
FINERACT_BASE_URL=https://localhost:8443/fineract-provider/api/v1
FINERACT_TENANT_ID=default
FINERACT_USERNAME=mifos
FINERACT_PASSWORD=password
# Localhost development only. Never use certificate bypass for a remote Fineract instance.
FINERACT_SSL_INSECURE=true

# ── Demo: settlement evidence writeback ────────────────────────────────────
# Set SAGITTA_EVIDENCE_WRITE=true to allow writing evidence back to Fineract.
# Set SAGITTA_DEMO_EVIDENCE=true to generate clearly-labelled synthetic evidence.
# SAGITTA_ACCOUNT_ID overrides the account id; defaults to id from lifecycle receipt.
SAGITTA_EVIDENCE_WRITE=false
SAGITTA_DEMO_EVIDENCE=true
SAGITTA_ACCOUNT_ID=

# ── Demo: fixed deposit lifecycle (CREATE_TEST_DATA=true) ──────────────────
# Set CREATE_TEST_DATA=true to enable the opt-in lifecycle demo.
# npm run smoke always remains read-only regardless of this flag.
CREATE_TEST_DATA=false

# Display name of the Fineract client that will be created or reused.
# Must start with SAGITTA_TEST. The last word is used as the Fineract lastname;
# everything before the last space is the firstname.
# Example: "SAGITTA_TEST CLIENT" → firstname=SAGITTA_TEST, lastname=CLIENT
SAGITTA_TEST_CLIENT_NAME=SAGITTA_TEST CLIENT

# Deposit principal in USD.
SAGITTA_TEST_DEPOSIT_AMOUNT=1000

# Fixed annual yield promised to the depositor (decimal: 0.06 = 6 %).
SAGITTA_TEST_FIXED_YIELD_APY=0.06

# Deposit term in months.
SAGITTA_TEST_TERM_MONTHS=12

# Current Sagitta treasury reserve balance in USD (local mock; in production
# this is read from the ReserveController on-chain contract).
SAGITTA_TEST_RESERVE_AMOUNT=100

# Reserve-to-promised-yield coverage ratio required before approval.
# 1.25 means the reserve must cover 125 % of the promised yield.
# Formula: requiredReserve = depositAmount * APY * (termMonths/12) * coverageRatio
SAGITTA_TEST_COVERAGE_RATIO=1.25
